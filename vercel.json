{
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run verify && npm run leaderboard && npm run build && rm -f dist/agents.md dist/llms.txt",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/agents.md",
      "destination": "/api/agents"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/agents"
    },
    {
      "source": "/api/text/:action",
      "destination": "/api/text?action=:action"
    },
    {
      "source": "/badge/:handle",
      "destination": "/api/badge?handle=:handle"
    },
    {
      "source": "/r/:run",
      "destination": "/api/share?run=:run"
    }
  ]
}